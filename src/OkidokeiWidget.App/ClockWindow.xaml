<Window x:Class="OkidokeiWidget.App.ClockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OkidokeiWidget"
        Icon="app.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">
    <Border x:Name="BackgroundBorder" CornerRadius="6"
            PreviewMouseLeftButtonDown="BackgroundBorder_PreviewMouseLeftButtonDown"
            MouseMove="BackgroundBorder_MouseMove"
            MouseLeftButtonUp="BackgroundBorder_MouseLeftButtonUp">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="詳細設定..." Click="OpenSettingsMenuItem_Click" />
                <Separator />
                <MenuItem x:Name="PositionLockMenuItem" Header="位置ロック" IsCheckable="True" Click="PositionLockMenuItem_Click" />
                <MenuItem x:Name="TopMostMenuItem" Header="最前面表示" IsCheckable="True" Click="TopMostMenuItem_Click" />
                <Separator />
                <MenuItem Header="終了" Click="ExitMenuItem_Click" />
            </ContextMenu>
        </Border.ContextMenu>
        <DockPanel x:Name="RootPanel" Margin="12" LastChildFill="True">
            <StackPanel x:Name="DateRow" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="DateText" />
                <TextBlock x:Name="DateDayOfWeekSpacer" Text=" " />
                <TextBlock x:Name="DayOfWeekText" />
            </StackPanel>
            <TextBlock x:Name="TimeText" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </DockPanel>
    </Border>
</Window>
